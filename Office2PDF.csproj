  <ItemGroup>
    <EmbeddedResource Include="Resources\qrcode.png">
	  <LogicalName>Office2PDF.Resources.qrcode.png</LogicalName>
	  <CopyToOutputDirectory>Never</CopyToOutputDirectory>
	</EmbeddedResource>
  </ItemGroup>

</Project>
